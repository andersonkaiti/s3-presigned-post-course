{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "warn"
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
